# Database & Auth
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/ligera"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
APP_URL="https://ligerascents.com"
NEXT_PUBLIC_SITE_URL="https://ligerascents.com"

# Flutterwave Payments
FLW_SECRET_KEY="FLWSECK_TEST-..."
FLW_SECRET_HASH="change-me-webhook-hash"
FLW_REDIRECT_URL="https://ligerascents.com/custom-requests/thanks"

# Cloudinary Media
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend Email
RESEND_API_KEY="re_..."
EMAIL_FROM="Ligera <orders@ligerascents.com>"

# Background Scheduler (set to "false" to disable)
ENABLE_SCHEDULER="true"

# Optional: Override client API base URL (leave unset for same-origin /api/*)
# NEXT_PUBLIC_API_URL=""

# Optional: Used by `scripts/seed-owner.ts`
# OWNER_EMAIL="orders@ligerascents.com"
# OWNER_NAME="Owner"
# OWNER_PASSWORD="change-me"
